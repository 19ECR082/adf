{
	"name": "email_demo",
	"properties": {
		"activities": [
			{
				"name": "send_email",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "complete_body_contain",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "POST",
					"headers": {
						"Content-Type": "application/json"
					},
					"url": "https://prod-11.northcentralus.logic.azure.com:443/workflows/f01e78ab61c84fb2b7c6209e480ecaab/triggers/When_an_HTTP_request_is_received/paths/invoke?api-version=2016-10-01&sp=%2Ftriggers%2FWhen_an_HTTP_request_is_received%2Frun&sv=1.0&sig=g2AKJ7j_scJtV7HlkhfgWVbZ90cbBqmNHYNeM7_g7Cg",
					"body": {
						"value": "@variables('logical_apps_body')",
						"type": "Expression"
					}
				}
			},
			{
				"name": "complete_body_contain",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "prepare_email_subject",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "email_body",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "logical_apps_body",
					"value": {
						"value": "{\n  \"email\": \"@{pipeline().parameters.recepient}\",\n  \"subject\":\"@{variables('email_subject')}\",\n  \"body\":\"@{variables('email_body')}\"\n}",
						"type": "Expression"
					}
				}
			},
			{
				"name": "prepare_email_subject",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "email_subject",
					"value": {
						"value": "@{pipeline().parameters.table_name} - @{pipeline().parameters.status}",
						"type": "Expression"
					}
				}
			},
			{
				"name": "email_body",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "email_body",
					"value": {
						"value": "the table @{pipeline().parameters.table_name} has been ingested and the status is @{pipeline().parameters.status}",
						"type": "Expression"
					}
				}
			}
		],
		"parameters": {
			"table_name": {
				"type": "string"
			},
			"status": {
				"type": "string"
			},
			"recepient": {
				"type": "string"
			}
		},
		"variables": {
			"logical_apps_body": {
				"type": "String"
			},
			"email_subject": {
				"type": "String"
			},
			"email_body": {
				"type": "String"
			}
		},
		"annotations": [],
		"lastPublishTime": "2026-11-23T16:22:13Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}