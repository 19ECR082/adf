{
	"name": "foreach-demo",
	"properties": {
		"activities": [
			{
				"name": "ingest_all_tables",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "get_table_lists",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('get_table_lists').output.value",
						"type": "Expression"
					},
					"isSequential": false,
					"batchCount": 2,
					"activities": [
						{
							"name": "execute_ingestion_pipeline",
							"type": "ExecutePipeline",
							"dependsOn": [],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "PL_demo_ingestion",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
								"parameters": {
									"table_name": {
										"value": "@item().table_name",
										"type": "Expression"
									}
								}
							}
						},
						{
							"name": "table_success",
							"description": "",
							"type": "AppendVariable",
							"dependsOn": [
								{
									"activity": "execute_ingestion_pipeline",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"variableName": "table_status",
								"value": {
									"value": "@{item().table_name} - success",
									"type": "Expression"
								}
							}
						},
						{
							"name": "table_failed",
							"description": "",
							"type": "AppendVariable",
							"dependsOn": [
								{
									"activity": "execute_ingestion_pipeline",
									"dependencyConditions": [
										"Failed"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"variableName": "table_status",
								"value": {
									"value": "@{item().table_name} - failed",
									"type": "Expression"
								}
							}
						}
					]
				}
			},
			{
				"name": "get_table_lists",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": "select * from metadata.table_list",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_SQL_SERVER",
						"type": "DatasetReference",
						"parameters": {
							"schema": "dbo",
							"table_name": "customers"
						}
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "send consolidated email",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "ingest_all_tables",
						"dependencyConditions": [
							"Completed"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "email_demo_mul",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"table_status": {
							"value": "@variables('table_status')",
							"type": "Expression"
						},
						"recepient": {
							"value": "@pipeline().globalParameters.email_id",
							"type": "Expression"
						}
					}
				}
			},
			{
				"name": "Fail1",
				"type": "Fail",
				"dependsOn": [
					{
						"activity": "ingest_all_tables",
						"dependencyConditions": [
							"Failed"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"message": "Due to previous activity pipline got failed",
					"errorCode": "500"
				}
			}
		],
		"variables": {
			"table_status": {
				"type": "Array"
			}
		},
		"annotations": [],
		"lastPublishTime": "2026-11-20T08:53:06Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}